<mvc:View controllerName="zspacemanager.controller.Home"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:tnt="sap.tnt"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.f"
    xmlns="sap.m">
    <Page id="page" showHeader="false" class="mainPage">
        <content>
            <VBox id="pageContent">

                <!-- HERO HEADER (same pattern as Payroll Workbench) -->
                <HBox id="heroHeader" class="heroHeader" justifyContent="SpaceBetween" alignItems="Center">
                    <!-- LEFT: HERO TEXT -->
                    <VBox id="heroTextBox" class="heroTextBox">
                        <Title id="heroTitle" text="PCC Space Manager" class="heroTitle"/>
                        <!-- <Text id="heroText" text="Browse and open your PCC spaces below." class="heroText"/> -->
                    </VBox>
                    <!-- RIGHT: LOGO -->
                    <VBox id="heroLogoBox" class="heroLogoBox">
                        <VBox id="appLogo" class="appLogo"/>
                    </VBox>
                </HBox>

                <!-- DYNAMIC PANELS (replacing Tree control) -->
                <VBox id="PCC_Space" class="panelContainer" items="{path: '/'}">
                    <Panel
                        id="panelSection"
                        expandable="true"
                        expanded="false"
                        width="100%"
                        class="customPanel sapUiMediumMarginBottom">
                        <headerToolbar>
                            <OverflowToolbar id="panelHeader" class="panelHeaderToolbar">
                                <core:Icon id="panelHeaderIcon" src="{ref}" class="panelHeaderIcon sapUiTinyMarginEnd" />
                                <Title id="panelHeaderTitle" text="{text}" level="H3" class="panelHeaderTitle" />
                            </OverflowToolbar>
                        </headerToolbar>
                        <content>
                            <HBox id="tileFlexBox" items="{nodes}" wrap="Wrap" class="tileContainer">
                                <GenericTile id="leafTile"
                                    class="sapUiTinyMargin leafTile"
                                    header="{text}"
                                    frameType="OneByOne"
                                    press=".onNavigateItemPress">
                                    <TileContent id="tileContent">
                                        <ImageContent id="tileImage" src="{ref}" />
                                    </TileContent>
                                </GenericTile>
                            </HBox>
                        </content>
                    </Panel>
                </VBox>

            </VBox>
        </content>
    </Page>
</mvc:View>