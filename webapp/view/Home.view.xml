<mvc:View controllerName="zspacemanager.controller.Home"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:tnt="sap.tnt"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.f"
    xmlns="sap.m">
    <Page id="page" title="{i18n>title}">
        <Tree
            id="PCC_Space"
            items="{path: '/', parameters: {arrayNames: ['nodes']}}">
            <headerToolbar>
                <OverflowToolbar id="_IDGenOverflowToolbar">
                    <Title id="_IDGenTitle" text="PCC Space" />
                    <ToolbarSpacer id="_IDGenToolbarSpacer" />
                </OverflowToolbar>
            </headerToolbar>
            <CustomTreeItem id="_IDGenCustomTreeItem1" class="sapUiTinyMarginTopBottom">
                <VBox id="_IDGenHBox" class="sapUiTinyMargin">

                    <!-- Parent nodes: plain row -->
                    <HBox id="_IDGenHBox1" visible="{= !!${nodes} }" alignItems="Center">
                        <core:Icon id="_IDGenIcon" src="{ref}" class="sapUiTinyMarginEnd" />
                        <Text id="_IDGenText1" text="{text}" />
                    </HBox>

                    <!-- Leaf / sub-nodes: rendered as Tile -->
                    <GenericTile id="_IDGenGenericTile"
                        visible="{= !${nodes} }"
                        class="sapUiTinyMarginTopBottom"
                        header="{text}"
                        frameType="OneByOne"
                        press=".onNavigateItemPress">
                        <TileContent id="_IDGenTileContent">
                            <ImageContent id="_IDGenImageContent" src="{ref}" />
                        </TileContent>
                    </GenericTile>
                </VBox>
            </CustomTreeItem>
      
        </Tree>
    </Page>
</mvc:View>